<Application x:Class="Fae.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
  <Style TargetType="Window"><Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="FontSize" Value="12"/><Setter Property="Background" Value="#F3F6FC"/><Setter Property="Foreground" Value="#18263D"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="6,4"/><Setter Property="Margin" Value="0,2,7,5"/><Setter Property="MinHeight" Value="28"/><Setter Property="BorderBrush" Value="#CFD8E7"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="5,4"/><Setter Property="Margin" Value="0,2,7,5"/><Setter Property="MinHeight" Value="28"/><Setter Property="BorderBrush" Value="#CFD8E7"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="0,2,7,3"/><Setter Property="Background" Value="#E7EEFC"/><Setter Property="Foreground" Value="#1D4ED8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E7EDF5"/><Setter Property="BorderBrush" Value="#DEE6F1"/><Setter Property="RowHeight" Value="26"/><Setter Property="ColumnHeaderHeight" Value="28"/><Setter Property="AlternatingRowBackground" Value="#F7FAFF"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="SelectionMode" Value="Single"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,6,10,5"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 </Application.Resources>
</Application>

