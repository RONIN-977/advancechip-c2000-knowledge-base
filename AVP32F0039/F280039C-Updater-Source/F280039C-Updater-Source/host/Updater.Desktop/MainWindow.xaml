<Window x:Class="Updater.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="C2000 统一固件升级" Width="1080" Height="800" MinWidth="640" MinHeight="480" ResizeMode="CanResizeWithGrip" SizeToContent="Manual" Background="#101827" Foreground="#DCE5F3" FontFamily="Microsoft YaHei UI" FontSize="14" WindowStartupLocation="CenterScreen">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <Grid Margin="20" Background="#101827">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="C2000 / FIRMWARE UPDATE" Foreground="#68D8CE" FontSize="12"/><TextBlock Text="C2000 统一固件升级" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,6"/><TextBlock Text="F280039C · AVP32F335 / SCI-A · 配套驻留 Bootloader" Foreground="#93A6BD"/></StackPanel>
  <Border Grid.Row="1" Background="#233448" CornerRadius="8" Padding="14" Margin="0,18,0,16"><TextBlock x:Name="ModeNotice" TextWrapping="Wrap" Foreground="#98DAD6"/></Border>
  <Grid Grid.Row="2" x:Name="SettingsPanel" Margin="0,0,0,16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="芯片型号" Margin="0,0,0,6"/><ComboBox x:Name="ChipModel" SelectedIndex="0" Padding="6" SelectionChanged="Chip_Changed"><ComboBoxItem Content="F280039C"/><ComboBoxItem Content="AVP32F335"/></ComboBox>
    <TextBlock Text="通信方式" Margin="0,12,0,6"/>
    <ComboBox x:Name="TransportMode" SelectedIndex="0" Padding="6" SelectionChanged="Mode_Changed"><ComboBoxItem Content="SCI 仿真"/><ComboBoxItem Content="CAN 仿真"/><ComboBoxItem Content="USB 串口 · SCI"/><ComboBoxItem Content="周立功 USB-CAN"/></ComboBox>
    <TextBlock Text="波特率（须与 Bootloader 一致）" Margin="0,12,0,6"/>
    <ComboBox x:Name="BaudRate" Padding="6"/>
    <CheckBox x:Name="DropAck" Content="仿真时丢弃一次 ACK" Foreground="#DCE5F3" Margin="0,14,0,0" IsChecked="True"/>
   </StackPanel>
   <StackPanel Grid.Column="2">
    <TextBlock Text="串口号 / CAN 盒型号" Margin="0,0,0,6"/>
    <Grid><TextBox x:Name="ComPort" Text="COM3" Padding="7"/><ComboBox x:Name="CanModel" SelectedIndex="1" Padding="6" Visibility="Collapsed"><ComboBoxItem Content="USBCAN-I"/><ComboBoxItem Content="USBCAN-II"/></ComboBox></Grid>
    <TextBlock Text="CAN 设备索引 / 通道（从 0 开始）" Margin="0,12,0,6"/>
    <UniformGrid Columns="2"><TextBox x:Name="CanIndex" Text="0" Padding="7" Margin="0,0,8,0"/><ComboBox x:Name="CanChannel" SelectedIndex="0" Padding="6"><ComboBoxItem Content="0"/><ComboBoxItem Content="1"/></ComboBox></UniformGrid>
   </StackPanel>
   <StackPanel Grid.Column="4">
    <TextBlock Text="CAN 节点地址（默认 1）" Margin="0,0,0,6"/><TextBox x:Name="NodeId" Text="1" Padding="7"/>
    <TextBlock Text="CAN 驱动（自动兼容 32 / 64 位）" Margin="0,12,0,6"/>
    <DockPanel><Button DockPanel.Dock="Right" Content="…" Click="Dll_Click" Padding="9,4" Margin="6,0,0,0"/><TextBox x:Name="DllPath" Padding="6" ToolTip="自动关联本机 CANPRO 的 usbcan.dll，也可选择 ControlCAN.dll"/></DockPanel>
   </StackPanel>
  </Grid>
  <Border Grid.Row="3" Background="#172236" CornerRadius="8" Padding="16" Margin="0,0,0,16">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="应用固件" FontWeight="SemiBold"/><TextBlock x:Name="ImageLabel" Text="直接选择 CCS 应用 .out（自动转换），也支持 SCI8 .txt / .hex 和 JSON" Foreground="#93A6BD" TextWrapping="Wrap" Margin="0,7,12,0"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="LoadButton" Content="选择固件" Click="Load_Click"/><Button x:Name="DemoButton" Content="演示数据" Click="Demo_Click" Margin="0"/></StackPanel>
   </Grid>
  </Border>
  <StackPanel Grid.Row="4">
   <WrapPanel><Button x:Name="EnterButton" Content="进入升级" Click="Enter_Click"/><Button x:Name="ProbeButton" Content="读取设备" Click="Probe_Click"/><Button x:Name="StartButton" Content="开始升级" Click="Start_Click" Background="#57CEC4" Foreground="#0C2927" FontWeight="SemiBold"/><Button x:Name="CancelButton" Content="取消" Click="Cancel_Click" IsEnabled="False"/><Button x:Name="ResetButton" Content="复位启动" Click="Reset_Click"/><CheckBox x:Name="AutoReset" Content="成功后复位" IsChecked="True" Foreground="#DCE5F3" VerticalAlignment="Center" Margin="4,0,0,0"/></WrapPanel>
   <ProgressBar x:Name="Progress" Height="8" Margin="0,18,0,10" Maximum="100" Foreground="#57CEC4"/>
   <TextBlock x:Name="StatusLabel" Text="就绪" Margin="0,0,0,14" TextWrapping="Wrap"/>
  </StackPanel>
  <TextBox Grid.Row="5" x:Name="Log" IsReadOnly="True" Background="#0B1220" Foreground="#A6B7CD" BorderThickness="0" Padding="14" FontFamily="Consolas,Microsoft YaHei UI" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="120" MaxHeight="360"/>
  <DockPanel Grid.Row="6" Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="保存日志" Click="SaveLog_Click" Padding="10,4" Margin="10,0,0,0"/><TextBlock x:Name="PartitionLabel" Text="应用：0x090000–0x0AEFFF（16 位字地址） · 默认 SCI 115200 / CAN 500k" Foreground="#8193AA" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
 </Grid>
 </ScrollViewer>
</Window>
