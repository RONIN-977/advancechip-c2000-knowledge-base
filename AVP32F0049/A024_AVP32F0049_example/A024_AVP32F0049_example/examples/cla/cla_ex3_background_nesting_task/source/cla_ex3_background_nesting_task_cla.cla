//-----------------------------------------------------------------------------
//
// Background Task
//
//-----------------------------------------------------------------------------
__attribute__((interrupt("background")))  void Cla1BackgroundTask ( void )
{
    //
    // Turn on LED2
    //
    GPIO_writePin(DEVICE_GPIO_PIN_LED2, 0);

    __mdebugstop();
    int32_t i;

    for(i = 2000000; i>=0; i--)
    {
        __asm(" MNOP");
        __asm(" MNOP");
        __asm(" MNOP");
        __asm(" MNOP");
        __asm(" MNOP");
        __asm(" MNOP");
        __asm(" MNOP");
        __asm(" MNOP");
        __asm(" MNOP");
        __asm(" MNOP");
    }

    //
    // Turn off LED2
    //
    GPIO_writePin(DEVICE_GPIO_PIN_LED2, 1);
}

