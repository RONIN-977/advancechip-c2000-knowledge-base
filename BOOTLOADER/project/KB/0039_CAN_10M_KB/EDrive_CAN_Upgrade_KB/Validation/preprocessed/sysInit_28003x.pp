void InitIsrCtrl(void){





    Interrupt_initModule();
    InitPieVectTable();

     
    __eallow();



    IER |= 0x0001;
    PieCtrlRegs.PIEIER1.bit.INTx1 = 0;  
    PieCtrlRegs.PIEIER1.bit.INTx3 = 0;  




    IER |= (0x0002);                            
    PieCtrlRegs.PIEIER2.bit.INTx1 = 0;  
    __edis();
}

void InitPeriherals(void){


    init_eCAN_A(20, 5, 4, 1, 2, 1);  
    
    Device_initGPIO();
    SetupGPIO();
    CAN_Config_Init();
    InitIsrCtrl();
    InitEPwmResExc();
    InitEPwmUVW();
    InitADC();
    InitCpuTimer();
    CpuTimer1Regs . TCR . bit . TSS = 0;
    CpuTimer0Regs . TCR . bit . TSS = 0;


}

