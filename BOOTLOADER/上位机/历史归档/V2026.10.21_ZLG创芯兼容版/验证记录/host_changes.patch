+    public static Task<DetectedCanDevice[]> AllCanDevicesAsync(string? manual, CancellationToken cancellation, Action<string> log) =>
+        ScanDriversAsync(CanDriver.Candidates(manual), CanDevicesAsync, cancellation, log);
+
+    // Each native SDK is probed in its own process. A failed vendor cannot hide the other vendor.
+    internal static async Task<DetectedCanDevice[]> ScanDriversAsync(IEnumerable<CanDriver.Driver> drivers,
+        Func<string, CancellationToken, Task<DetectedCanDevice[]>> scan, CancellationToken cancellation, Action<string> log)
+    {
+        var results = await Task.WhenAll(drivers.Select(async driver =>
+        {
+            try
+            {
+                var devices = await scan(driver.Path, cancellation);
+                cancellation.ThrowIfCancellationRequested();
+                return devices.Where(device => driver.Brand != "创芯科技" || device.Type == 4)
+                    .Select(device => device with { Brand = driver.Brand, DriverPath = driver.Path }).ToArray();
+            }
+            catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { throw; }
+            catch (Exception ex) { log(driver.Brand + " 检测：" + ex.Message); return Array.Empty<DetectedCanDevice>(); }
+        }));
+        cancellation.ThrowIfCancellationRequested();
+        return results.SelectMany(devices => devices).DistinctBy(device =>
+            (device.DriverPath.ToUpperInvariant(), device.Type, device.Serial.Length == 0 ? "#" + device.Index : device.Serial)).ToArray();
+    }
