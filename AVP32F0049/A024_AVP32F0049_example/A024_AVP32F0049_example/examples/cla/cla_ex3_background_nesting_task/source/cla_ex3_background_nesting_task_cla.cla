//
// Included Files
//
#include <stdint.h>
#include "device.h"
#include "cla_ex3_background_nesting_task_shared.h"
#include "driverlib.h"

//-----------------------------------------------------------------------------
//
// Task 1
//
//-----------------------------------------------------------------------------
__attribute__((interrupt)) void Cla1Task1 ( void )
{
    //
    // Turn on LED1
    //
    GPIO_writePin(DEVICE_GPIO_PIN_LED1, 0);

    //__mdebugstop();
    int32_t i;
    for(i = 250000; i>=0; i--)
    {
        __asm(" MNOP");
        __asm(" MNOP");
        __asm(" MNOP");
        __asm(" MNOP");
        __asm(" MNOP");
        __asm(" MNOP");
        __asm(" MNOP");
        __asm(" MNOP");
        __asm(" MNOP");
        __asm(" MNOP");
    }

    //
    // Turn off LED1
    //
    GPIO_writePin(DEVICE_GPIO_PIN_LED1, 1);

    //
    // Clear EPWM interrupt flag
    //
    EPWM_clearEventTriggerInterruptFlag(EPWM1_BASE);
}

